{
  "name": "swing-backtester",
  "version": "0.1.0",
  "description": "Swing trade backtester with trailing stop analysis",
  "type": "module",
  "scripts": {
    "dev": "tsx watch",
    "api": "tsx src/api/server.ts",
    "api:dev": "tsx watch src/api/server.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "build": "tsc",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "seed": "tsx prisma/seed.ts",
    "ingest-ohlc": "tsx scripts/ingest-ohlc.ts",
    "ingest-ohlc-bulk": "tsx scripts/ingest-ohlc-bulk.ts",
    "import-trades": "tsx scripts/import-trades.ts",
    "compute-regimes": "tsx scripts/compute-regimes.ts",
    "create-scenarios-v2": "tsx scripts/create-scenarios-v2.ts",
    "run-backtest": "tsx scripts/run-backtest.ts",
    "print-results": "tsx scripts/print-results.ts",
    "export-results": "tsx scripts/export-results.ts",
    "list-runs": "tsx scripts/list-runs.ts",
    "cleanup-trades": "tsx scripts/cleanup-trades.ts",
    "migrate-v1-scenarios": "tsx scripts/migrate-v1-scenarios-to-scoped.ts",
    "standardize-scenarios": "tsx scripts/standardize-scenario-names.ts",
    "find-duplicate-scenarios": "tsx scripts/find-duplicate-scenarios.ts",
    "remove-duplicate-scenarios": "tsx scripts/remove-duplicate-scenarios.ts",
    "validate-security-integrity": "tsx scripts/validate-security-integrity.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.3.2",
    "@mantine/hooks": "^9.3.2",
    "@prisma/client": "^5.10.2",
    "@vitejs/plugin-react": "^6.0.2",
    "axios": "^1.6.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.21.0",
    "papaparse": "^5.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "vite": "^8.0.16",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.6",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prisma": "^5.10.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
